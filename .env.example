# Copy to .env for local development (`make dev` and the make targets load it).
# Values here are examples: change the passwords before using them anywhere else.
# The full list of settings, with their defaults, is in config/base.py.

ENVIRONMENT=local

# PostgreSQL 17 (the `db` service of docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=faclab
# One role per job (row-level security, S2.4): the API connects as faclab_app,
# the worker (outbox relay, consumer, purges) as faclab_worker (bypasses
# row-level security) and the migrations as faclab_owner, the owner of the tables. `make db-roles` creates
# them with these passwords through the superuser of DATABASE_URL_ADMIN; run it
# before `make upgrade`
DATABASE_URL=postgresql://faclab_app:change-me-app@db:5432/faclab
DATABASE_URL_WORKER=postgresql://faclab_worker:change-me-worker@db:5432/faclab
DATABASE_URL_MIGRATIONS=postgresql://faclab_owner:change-me-owner@db:5432/faclab
DATABASE_URL_ADMIN=postgresql://postgres:change-me@db:5432/postgres

# OpenTelemetry towards SigNoz local: start it first with faclab-infra's
# `scripts/signoz.sh up`, which joins its collector to faclab_network.
# With OTEL_ENABLED=false nothing is exported.
OTEL_ENABLED=true
OTEL_OTLP_ENDPOINT=http://signoz-otel-collector:4317
# Plain text towards the collector; only local (the default here)
# OTEL_EXPORTER_OTLP_INSECURE=true
# Tag or commit SHA in logs and traces; the production image sets it at build time
# SERVICE_VERSION=dev

# Kafka from faclab-infra (sales.confirmed out, invoices in)
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
# The `worker` service runs the outbox relay, the consumer and the purges;
# docker-compose.yml turns them off in the API (RUN_BACKGROUND=false). Retries:
# OUTBOX_MAX_ATTEMPTS=10, KAFKA_CONSUMER_MAX_ATTEMPTS=5; retention:
# OUTBOX_RETENTION_DAYS=14, AUTH_SESSION_RETENTION_DAYS=30; the queue gauges
# sample the database every WORKER_METRICS_INTERVAL_SECONDS=60

# Quotes by email (S5.4): Mailpit from faclab-infra (UI on http://localhost:8025).
# Elsewhere SMTP_PORT=587 with STARTTLS (or SMTP_SECURE=true on 465), SMTP_USER
# and SMTP_PASSWORD
EMAIL_ENABLED=true
EMAIL_FROM=no-reply@faclab.local
SMTP_HOST=mailpit
SMTP_PORT=1025

# Shift closing (S5.9): a counted difference over this amount needs a
# justification (0 = any difference)
# SHIFT_CLOSING_JUSTIFICATION_THRESHOLD=1.00

# Token signing key (S6.1): an Ed25519 private key in PEM. Locally a fixed
# development key signs when none is set; staging and production require one
# (`openssl genpkey -algorithm ed25519 -out jwt.pem`). During a rotation,
# JWT_PUBLIC_KEYS(_FILE) holds the previous public key (docs/auth-spec.md)
# JWT_PRIVATE_KEY_FILE=/run/secrets/jwt.pem
# JWT_PUBLIC_KEYS_FILE=

# Integration clients (S6.2, POST /api/oauth/token): false refuses their tokens
# (rollback switch). The environment is the deployment's: sandbox (fl_test_
# credentials) everywhere but production (fl_live_). Revoking a client takes
# effect within the status cache (0 to 60 seconds)
# INTEGRATIONS_ENABLED=true
# INTEGRATION_ENVIRONMENT=sandbox
# INTEGRATION_STATUS_CACHE_SECONDS=30

# Public documentation for integrators (S6.5): /docs/public, also where
# DOCS_ENABLED is off. `make sandbox` creates a sandbox company (refuses
# outside INTEGRATION_ENVIRONMENT=sandbox); see docs/sandbox.md
# PUBLIC_DOCS_ENABLED=true

# Signed webhooks (S6.4). WEBHOOKS_ENABLED=false enqueues nothing and turns
# their routes off; WEBHOOK_DELIVERY_ENABLED=false only pauses the worker's
# sending. The endpoints' secrets are encrypted with SECRET_ENCRYPTION_KEYS
# (Fernet keys separated by commas, the first one encrypts; required outside
# local): python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# WEBHOOK_ALLOW_PRIVATE_URLS=true lets an endpoint point at this machine (local only)
# WEBHOOKS_ENABLED=true
# WEBHOOK_DELIVERY_ENABLED=true
# WEBHOOK_TIMEOUT_SECONDS=10
# WEBHOOK_CONCURRENCY=8
# WEBHOOK_STOCK_BATCH_SECONDS=30
# WEBHOOK_RETENTION_DAYS=30
# WEBHOOK_ALLOW_PRIVATE_URLS=false
# SECRET_ENCRYPTION_KEYS=
# SECRET_ENCRYPTION_KEYS_FILE=/run/secrets/secret-encryption-keys

# Default tenant and its first admin for `make seed-admin`. Locally the tenant
# defaults to a made-up RUC; staging and production need
# AUTH_SEED_TENANT_RUC and AUTH_SEED_TENANT_NAME
AUTH_SEED_USERNAME=admin
AUTH_SEED_EMAIL=admin@example.com
AUTH_SEED_PASSWORD=
