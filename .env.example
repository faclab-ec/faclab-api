# Copy to .env for local development (`make dev` and the make targets load it).
# Values here are examples: change the passwords before using them anywhere else.
# The full list of settings, with their defaults, is in config/base.py.

ENVIRONMENT=local

# PostgreSQL 17 (the `db` service of docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=faclab
DATABASE_URL=postgresql://postgres:change-me@db:5432/faclab

# OpenTelemetry towards SigNoz local: start it first with faclab-infra's
# `scripts/signoz.sh up`, which joins its collector to faclab_network.
# With OTEL_ENABLED=false nothing is exported.
OTEL_ENABLED=true
OTEL_OTLP_ENDPOINT=http://signoz-otel-collector:4317
# Plain text towards the collector; only local (the default here)
# OTEL_EXPORTER_OTLP_INSECURE=true
# Tag or commit SHA in logs and traces; the production image sets it at build time
# SERVICE_VERSION=dev

# Kafka from faclab-infra (sales.confirmed out, invoices in)
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Default tenant and its first admin for `make seed-admin`. Locally the tenant
# defaults to a made-up RUC; staging and production need
# AUTH_SEED_TENANT_RUC and AUTH_SEED_TENANT_NAME
AUTH_SEED_USERNAME=admin
AUTH_SEED_EMAIL=admin@example.com
AUTH_SEED_PASSWORD=
