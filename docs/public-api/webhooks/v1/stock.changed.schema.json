{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://faclab.ec/webhooks/v1/stock.changed.schema.json",
  "$defs": {
    "StockChangedData": {
      "properties": {
        "productId": {
          "type": "integer"
        },
        "sku": {
          "type": "string"
        },
        "branchId": {
          "type": "integer"
        },
        "available": {
          "description": "In base units, in every location of the branch: what is there minus what transfers reserved",
          "examples": [
            "2.5"
          ],
          "pattern": "^\\d+(\\.\\d{1,6})?$",
          "type": "string"
        }
      },
      "required": [
        "productId",
        "sku",
        "branchId",
        "available"
      ],
      "type": "object"
    }
  },
  "properties": {
    "id": {
      "description": "The `webhook-id`: the same in every attempt",
      "type": "string"
    },
    "version": {
      "const": 1,
      "type": "integer"
    },
    "occurredAt": {
      "description": "When it happened",
      "examples": [
        "2026-11-17T15:04:05.000Z"
      ],
      "format": "date-time",
      "type": "string"
    },
    "tenantId": {
      "description": "The company",
      "format": "uuid",
      "type": "string"
    },
    "originClientId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The client_id of the integration whose request caused it; null for a user's or the system's"
    },
    "type": {
      "const": "stock.changed",
      "type": "string"
    },
    "data": {
      "$ref": "#/$defs/StockChangedData"
    }
  },
  "required": [
    "id",
    "version",
    "occurredAt",
    "tenantId",
    "originClientId",
    "type",
    "data"
  ],
  "type": "object",
  "title": "stock.changed v1"
}
